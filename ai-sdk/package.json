{
  "name": "@equibles/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK tools for Equibles: SEC filings, earnings call transcripts, financial statements, prices, insider trades, 13F holders, short interest, guidance and analyst estimates.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "agents",
    "equibles",
    "sec-filings",
    "earnings-calls",
    "financial-data",
    "stocks"
  ],
  "homepage": "https://equibles.com/docs/api/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equibles/equibles-integrations.git",
    "directory": "ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/equibles/equibles-integrations/issues"
  },
  "license": "MIT",
  "author": "Equibles <social@equibles.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.181",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
